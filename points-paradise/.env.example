# Points & Paradise — copy to .env.local (local) or set in Vercel (production).
# Never commit real values. Every provider key is optional.

# --- Sign-in (required) ------------------------------------------------------
OWNER_EMAIL=you@example.com
# Output of: npm run hash-password -- 'your long passphrase'
OWNER_PASSWORD_HASH=
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Public URL used in email links
APP_URL=http://localhost:3000

# --- Database -----------------------------------------------------------------
# Production: Supabase transaction-pooler connection string (port 6543).
# Leave empty locally to use the embedded PGlite database in .data/pglite.
DATABASE_URL=
DATABASE_POOL_MAX=3
# PGLITE_DIR=.data/pglite
# Only for running a production build on PGlite (e.g. local `next start`).
# ALLOW_PGLITE=true

# --- Scheduled jobs -----------------------------------------------------------
# Bearer token for /api/cron/daily and /api/cron/frequent (Vercel Cron sends it automatically).
CRON_SECRET=

# --- Optional providers (each stays off until its key is set) -----------------
# seats.aero Pro — cached award availability (personal, non-commercial use only)
SEATS_AERO_API_KEY=
# SerpApi — comparable cash fares (Google Flights) and hotel rates (Google Hotels)
SERPAPI_API_KEY=
# Resend — email alerts and daily digest
RESEND_API_KEY=
EMAIL_FROM="Points & Paradise <alerts@yourdomain.com>"
# Anthropic — AI-written explanations, ideas and trip narratives (prose only)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Unsplash — destination photos with photographer credit
UNSPLASH_ACCESS_KEY=
# Comma- or space-separated https:// RSS/Atom feeds for transfer-bonus announcements
RSS_FEEDS=
