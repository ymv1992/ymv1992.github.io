# Vanta Wealth — copy to .env.local (local) or set in Vercel (production).
# Never commit real values. No personal financial data belongs in this file or this repository.

# --- Sign-in (required) ------------------------------------------------------
OWNER_EMAIL=you@example.com
# Created on the sign-in page the first time you open the app (or: npm run hash-password -- 'passphrase')
OWNER_PASSWORD_HASH=
# 32+ random characters; also created on the first-time setup screen
SESSION_SECRET=

# --- Database -----------------------------------------------------------------
# Production: Supabase transaction-pooler connection string (port 6543).
# The app keeps its tables in their own "vanta" schema, so it can share a database with another app.
# Leave empty locally to use the embedded PGlite database in .data/pglite.
DATABASE_URL=
DATABASE_POOL_MAX=3

# --- Market data (each stays off until set) ------------------------------------
# Finnhub free plan: stock/ETF quotes, company news, earnings calendar
FINNHUB_API_KEY=
# Optional CoinGecko demo key; crypto prices work without it at a low rate limit
COINGECKO_API_KEY=

# --- Scheduled job --------------------------------------------------------------
# Bearer token for /api/cron/daily (Vercel Cron sends it automatically)
CRON_SECRET=
